[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://scripts/storage/item_amount.gd" id="1_amt"]
[ext_resource type="Resource" path="res://data/items/log.tres" id="2_tro"]
[ext_resource type="Script" path="res://scripts/missions/mission_data.gd" id="3_mis"]

[sub_resource type="Resource" id="Pide_troncos"]
script = ExtResource("1_amt")
item = ExtResource("2_tro")
amount = 20

[resource]
script = ExtResource("3_mis")
id = &"primeras_casas"
title = "Las primeras casas de Azul"
intro = "Los colonos siguen durmiendo en carpas, y con el frío que viene no aguantan. Si nos traés troncos del monte, levantamos las dos primeras casas en el lote de atrás. Los que manda el Ferrocarril ya tienen dueño: estos los tenés que juntar vos. Son 20; traelos en la plataforma y entregalos en el cartel de la obra."
outro = "¡Mirá esas casas! Los Pereyra y los Sosa ya no duermen en carpa. Y quedó lugar para una familia más: si conocés a alguien que quiera venir a Azul, decile."
station_id = &"azul"
kind = 3
delivery = Array[ExtResource("1_amt")]([SubResource("Pide_troncos")])
min_level = 2
reward_money = 150
