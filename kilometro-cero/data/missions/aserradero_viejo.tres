[resource]
script = ExtResource("3_jmlm2")
id = &"aserradero_viejo"
title = "La vía al aserradero viejo"
intro = "En los años buenos salían de acá tres trenes de rollizos por día. El aserradero del arroyo cortaba para media provincia. Cuando levantaron el ramal, el monte se tragó la vía. Si la volvés a abrir, el aserradero puede volver a trabajar."
outro = "¿Escuchás? La sierra otra vez. Hacía treinta años que no se oía. Con el aserradero andando, la maderera va a poder mandar mucho más."
station_id = &"maderera"
kind = 1
segment_id = &"m_a"
reward_money = 300
