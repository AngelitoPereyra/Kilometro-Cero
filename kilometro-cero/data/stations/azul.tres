[gd_resource type="Resource" script_class="StationData" format=3]

[ext_resource type="Script" path="res://scripts/stations/station_level_data.gd" id="1_lvl"]
[ext_resource type="Script" path="res://scripts/storage/item_amount.gd" id="2_amt"]
[ext_resource type="Script" path="res://scripts/stations/station_data.gd" id="3_sta"]
[ext_resource type="Resource" path="res://data/items/cement.tres" id="i_cement"]
[ext_resource type="Resource" path="res://data/items/limestone.tres" id="i_limestone"]
[ext_resource type="Resource" path="res://data/items/log.tres" id="i_log"]
[ext_resource type="Resource" path="res://data/items/settlers.tres" id="i_settlers"]
[ext_resource type="Resource" path="res://data/items/travelers.tres" id="i_travelers"]

[sub_resource type="Resource" id="Cant_1_travelers"]
script = ExtResource("2_amt")
item = ExtResource("i_travelers")
amount = 3

[sub_resource type="Resource" id="Cant_0_log"]
script = ExtResource("2_amt")
item = ExtResource("i_log")
amount = 10

[sub_resource type="Resource" id="Cant_2_settlers"]
script = ExtResource("2_amt")
item = ExtResource("i_settlers")
amount = 5

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("1_lvl")
needs = Array[ExtResource("2_amt")]([SubResource("Cant_2_settlers")])
days_to_grow = 1
description = "Pueblo casi vacío: el monte creció y el hachero que queda apenas saca 10 troncos por día."

[sub_resource type="Resource" id="Cant_3_limestone"]
script = ExtResource("2_amt")
item = ExtResource("i_limestone")
amount = 10

[sub_resource type="Resource" id="Cant_4_cement"]
script = ExtResource("2_amt")
item = ExtResource("i_cement")
amount = 5

[sub_resource type="Resource" id="Cant_5_log"]
script = ExtResource("2_amt")
item = ExtResource("i_log")
amount = 10

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("1_lvl")
needs = Array[ExtResource("2_amt")]([SubResource("Cant_3_limestone"), SubResource("Cant_4_cement")])
days_to_grow = 2
extra_production = Array[ExtResource("2_amt")]([SubResource("Cant_5_log")])
market = true
description = "Llegaron los colonos: más hacheros en el monte (10 troncos más) y abre el almacén de ramos generales."

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("1_lvl")
market = true
description = "Pueblo con vida: casas de material, plaza y la escuela cuando llega la maestra."

[resource]
script = ExtResource("3_sta")
id = &"azul"
display_name = "Azul"
type = 1
region = &"hito_a"
production = Array[ExtResource("2_amt")]([SubResource("Cant_1_travelers"), SubResource("Cant_0_log")])
levels = Array[ExtResource("1_lvl")]([SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")])
