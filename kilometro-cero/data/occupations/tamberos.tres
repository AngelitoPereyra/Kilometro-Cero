[gd_resource type="Resource" script_class="OccupationData" format=3]

[ext_resource type="Script" path="res://scripts/stations/occupation_data.gd" id="1_ofi"]
[ext_resource type="Script" path="res://scripts/storage/item_amount.gd" id="2_amt"]
[ext_resource type="Resource" path="res://data/items/milk.tres" id="i_milk"]

[sub_resource type="Resource" id="Da_milk"]
script = ExtResource("2_amt")
item = ExtResource("i_milk")
amount = 5

[resource]
script = ExtResource("1_ofi")
id = &"tamberos"
display_name = "tamberos"
kind = 0
produces = Array[ExtResource("2_amt")]([SubResource("Da_milk")])
requires_trait = &"campo"
description = "Ordeñan en el tambo: 5 tarros de leche por familia y por día."
